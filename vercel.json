{
  "name": "storage-foil",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "src/**/*.ts"
    }
  },
  "crons": [
    {
      "path": "/api/sync/http",
      "schedule": "5 0 * * *"
    }
  ]
}
